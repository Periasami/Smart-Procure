generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model bookings {
  id                     Int            @id @default(autoincrement())
  farmer_id              Int
  schedule_id            Int
  token_number           Int
  booking_date           DateTime?      @default(now()) @db.Timestamp(6)
  status                 String         @default("BOOKED") @db.VarChar(30)
  estimated_wait_minutes Int?
  created_at             DateTime?      @default(now()) @db.Timestamp(6)
  updated_at             DateTime?      @default(now()) @db.Timestamp(6)
  farmers                farmers        @relation(fields: [farmer_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  schedules              schedules      @relation(fields: [schedule_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  procurements           procurements?
  queue_entries          queue_entries?

  @@unique([farmer_id, schedule_id])
  @@unique([schedule_id, token_number])
}

model centre_crops {
  centre_id Int
  crop_id   Int
  centres   centres @relation(fields: [centre_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  crops     crops   @relation(fields: [crop_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([centre_id, crop_id])
}

model centres {
  id              Int            @id @default(autoincrement())
  name            String         @db.VarChar(150)
  address         String
  village         String?        @db.VarChar(100)
  district        String?        @db.VarChar(100)
  state           String?        @db.VarChar(100)
  latitude        Decimal?       @db.Decimal(10, 7)
  longitude       Decimal?       @db.Decimal(10, 7)
  capacity        Int            @default(0)
  active_counters Int            @default(0)
  status          String         @default("AVAILABLE") @db.VarChar(30)
  created_at      DateTime?      @default(now()) @db.Timestamp(6)
  updated_at      DateTime?      @default(now()) @db.Timestamp(6)
  centre_crops    centre_crops[]
  schedules       schedules[]
}

model crops {
  id           Int            @id @default(autoincrement())
  name         String         @unique @db.VarChar(100)
  created_at   DateTime?      @default(now()) @db.Timestamp(6)
  centre_crops centre_crops[]
  schedules    schedules[]
}

model farmers {
  id         Int        @id @default(autoincrement())
  user_id    Int        @unique
  address    String?
  village    String?    @db.VarChar(100)
  district   String?    @db.VarChar(100)
  state      String?    @db.VarChar(100)
  created_at DateTime?  @default(now()) @db.Timestamp(6)
  bookings   bookings[]
  users      users      @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model notifications {
  id         Int       @id @default(autoincrement())
  user_id    Int
  title      String    @db.VarChar(150)
  message    String
  type       String    @db.VarChar(50)
  is_read    Boolean   @default(false)
  created_at DateTime? @default(now()) @db.Timestamp(6)
  users      users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model payments {
  id                    Int          @id @default(autoincrement())
  procurement_id        Int          @unique
  amount                Decimal      @db.Decimal(12, 2)
  payment_method        String?      @db.VarChar(50)
  transaction_reference String?      @unique @db.VarChar(100)
  status                String       @default("PENDING") @db.VarChar(30)
  paid_at               DateTime?    @db.Timestamp(6)
  created_at            DateTime?    @default(now()) @db.Timestamp(6)
  updated_at            DateTime?    @default(now()) @db.Timestamp(6)
  procurements          procurements @relation(fields: [procurement_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model procurements {
  id                Int       @id @default(autoincrement())
  booking_id        Int       @unique
  quantity_kg       Decimal   @db.Decimal(10, 2)
  procurement_price Decimal   @db.Decimal(10, 2)
  total_amount      Decimal   @db.Decimal(12, 2)
  status            String    @default("PENDING") @db.VarChar(30)
  procured_at       DateTime? @db.Timestamp(6)
  created_at        DateTime? @default(now()) @db.Timestamp(6)
  updated_at        DateTime? @default(now()) @db.Timestamp(6)
  payments          payments?
  bookings          bookings  @relation(fields: [booking_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model queue_entries {
  id             Int       @id @default(autoincrement())
  booking_id     Int       @unique
  queue_position Int
  status         String    @default("WAITING") @db.VarChar(30)
  joined_at      DateTime? @default(now()) @db.Timestamp(6)
  called_at      DateTime? @db.Timestamp(6)
  completed_at   DateTime? @db.Timestamp(6)
  bookings       bookings  @relation(fields: [booking_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model schedules {
  id            Int        @id @default(autoincrement())
  centre_id     Int
  crop_id       Int
  schedule_date DateTime   @db.Date
  start_time    DateTime   @db.Time(6)
  end_time      DateTime   @db.Time(6)
  slot_capacity Int
  booked_slots  Int        @default(0)
  status        String     @default("OPEN") @db.VarChar(30)
  created_at    DateTime?  @default(now()) @db.Timestamp(6)
  bookings      bookings[]
  centres       centres    @relation(fields: [centre_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  crops         crops      @relation(fields: [crop_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model users {
  id            Int             @id @default(autoincrement())
  name          String          @db.VarChar(100)
  phone         String          @unique @db.VarChar(15)
  email         String?         @unique @db.VarChar(150)
  password_hash String
  role          String          @default("FARMER") @db.VarChar(30)
  created_at    DateTime?       @default(now()) @db.Timestamp(6)
  updated_at    DateTime?       @default(now()) @db.Timestamp(6)
  farmers       farmers?
  notifications notifications[]
}
